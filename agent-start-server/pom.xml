<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.aigoodle</groupId>
        <artifactId>agent-start</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>agent-start-server</artifactId>
    <name>agent-start-server</name>
    <description>Standalone Spring Boot server: bundles every module and exposes /api/v1 REST + SSE endpoints. Run this to have a working backend without embedding the SDK into your own app.</description>

    <dependencies>
        <!-- MVC-style REST surface (CRUD, admin, dataset upload, non-streaming SSE
             via SseEmitter). We pull it in for the endpoints but explicitly EXCLUDE
             spring-boot-starter-web / Tomcat so the server runtime stays Netty-only —
             see spring.main.web-application-type=reactive in application.yml. -->
        <dependency>
            <groupId>io.github.aigoodle</groupId>
            <artifactId>agent-start-web</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-starter-web</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>org.springdoc</groupId>
                    <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <!-- Reactive AI-chat surface (OpenAI /chat/completions + Dify /chat-messages,
             both streaming and blocking). Ships spring-boot-starter-webflux, which is
             what actually starts Netty for this server. -->
        <dependency>
            <groupId>io.github.aigoodle</groupId>
            <artifactId>agent-start-completion</artifactId>
        </dependency>

        <!-- OpenAPI 3 spec + Swagger UI (reactive flavor, matches the Netty stack). -->
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webflux-ui</artifactId>
        </dependency>

        <dependency>
            <groupId>io.github.aigoodle</groupId>
            <artifactId>agent-start-workflow</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.aigoodle</groupId>
            <artifactId>agent-start-knowledge</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.aigoodle</groupId>
            <artifactId>agent-start-agent</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.aigoodle</groupId>
            <artifactId>agent-start-tools</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.aigoodle</groupId>
            <artifactId>agent-start-trigger</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.aigoodle</groupId>
            <artifactId>agent-start-observability</artifactId>
        </dependency>

        <!-- PostgreSQL is the only supported datasource for the server module. Start
             Postgres first (see pgsql/init.sql + pgsql/docker-compose.yml) — no H2
             fallback because the schema uses PG-native features (TIMESTAMPTZ, TEXT,
             stringtype=unspecified). -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <version>42.7.8</version>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>io.github.aigoodle.server.SpringAgentServerApplication</mainClass>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
